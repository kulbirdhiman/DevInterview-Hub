# Copy to .env and fill in real values:  cp .env.example .env
# Consumed by docker compose (see docker-compose.yml).

# ---- Clerk (https://dashboard.clerk.com -> API keys) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Signing secret of the Clerk webhook endpoint pointed at /api/webhooks
CLERK_WEBHOOK_SECRET=whsec_xxx

# ---- Database ----
# Defaults to the bundled mongo service; point at Atlas to use a hosted cluster.
MONGODB_URI=mongodb://mongo:27017/devinterview

# ---- URLs / CORS ----
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---- Host ports ----
FRONTEND_PORT=3000
# macOS: port 5000 is taken by Control Center (AirPlay Receiver), so use 5001
BACKEND_PORT=5001
MONGO_PORT=27017
